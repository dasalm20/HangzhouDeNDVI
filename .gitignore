# ---- Environments (platform specific, never share) ----
.venv/
venv/
env/
ENV/

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# ---- Data: large, re-downloadable via 01_get_landsat.py ----
01-Data/
!01-Data/.gitkeep

# ---- Outputs: large, regenerated by the scripts ----
# Covers Clean, Indices, Figures, Validation, Classification, Change,
# Accuracy and the ENVI flat-binary exports (including the extensionless
# data files that pair with each .hdr).
03-Output/
!03-Output/.gitkeep

# ---- OS and editor junk ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.Rproj.user/
.Rhistory
# Google Drive shortcut stubs
*.gdoc
*.gsheet
*.gslides

# Office lock files
~$*
